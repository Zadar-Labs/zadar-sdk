<?xml version="1.0"?>
<package format="2">
  <name>zadar_udp_driver</name>
  <version>0.1.0</version>
  <description>ROS 1 C++ driver for Zadar UDP radar sensors.</description>

  <maintainer email="support-team@zadarlabs.com">Zadar Labs</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>libcurl4-openssl-dev</build_depend>
  <build_depend>protobuf</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>zadar_msgs</build_depend>

  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>libcurl4-openssl-dev</build_export_depend>
  <build_export_depend>protobuf</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>zadar_msgs</build_export_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>protobuf</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>zadar_msgs</exec_depend>
</package>
