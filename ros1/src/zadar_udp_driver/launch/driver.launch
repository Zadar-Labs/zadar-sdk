<launch>
  <arg name="driver_package" default="zadar_udp_driver"/>
  <arg name="driver_executable" default="zadar_udp_driver_node"/>
  <arg name="namespace" default="zadar"/>
  <arg name="sensor_name" default=""/>
  <arg name="node_namespace" default="$(eval '/'.join([part for part in [str(arg('namespace')).strip('/'), str(arg('sensor_name')).strip('/')] if part]))"/>
  <arg name="params_file" default="$(find zadar_udp_driver)/config/driver.yaml"/>
  <arg name="udp_bind_address" default=""/>
  <arg name="bind_address" default=""/>
  <arg name="sensor_hostname" default=""/>
  <arg name="host_ip" default=""/>
  <arg name="data_port" default="0"/>
  <arg name="imu_port" default="0"/>
  <arg name="webapi_port" default="8080"/>
  <arg name="webapi_timeout_sec" default="2.0"/>
  <arg name="running_mode" default="-1"/>
  <arg name="frame_id" default="$(eval str(arg('sensor_name')).strip('/') if str(arg('sensor_name')).strip('/') else (str(arg('namespace')).strip('/').replace('/', '_') if str(arg('namespace')).strip('/') else 'zadar'))"/>
  <arg name="publish_scan" default="true"/>
  <arg name="publish_clusters" default="true"/>
  <arg name="publish_tracks" default="true"/>
  <arg name="publish_odometry" default="true"/>
  <arg name="publish_imu" default="true"/>
  <arg name="radar_socket_buffer_bytes" default="67108864"/>
  <arg name="imu_socket_buffer_bytes" default="4194304"/>
  <arg name="max_buffered_frames" default="128"/>
  <arg name="frame_timeout_sec" default="1.0"/>
  <arg name="socket_timeout_sec" default="0.25"/>
  <arg name="generated_python_dir" default=""/>

  <node
    pkg="$(arg driver_package)"
    type="$(arg driver_executable)"
    name="zadar_udp_driver"
    ns="$(arg node_namespace)"
    output="screen"
    clear_params="true">
    <rosparam command="load" file="$(arg params_file)"/>
    <param name="udp_bind_address" value="$(arg udp_bind_address)"/>
    <param name="bind_address" value="$(arg bind_address)"/>
    <param name="sensor_hostname" value="$(arg sensor_hostname)"/>
    <param name="host_ip" value="$(arg host_ip)"/>
    <param name="data_port" value="$(arg data_port)" type="int"/>
    <param name="imu_port" value="$(arg imu_port)" type="int"/>
    <param name="webapi_port" value="$(arg webapi_port)" type="int"/>
    <param name="webapi_timeout_sec" value="$(arg webapi_timeout_sec)" type="double"/>
    <param name="running_mode" value="$(arg running_mode)" type="int"/>
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="publish_scan" value="$(arg publish_scan)" type="bool"/>
    <param name="publish_clusters" value="$(arg publish_clusters)" type="bool"/>
    <param name="publish_tracks" value="$(arg publish_tracks)" type="bool"/>
    <param name="publish_odometry" value="$(arg publish_odometry)" type="bool"/>
    <param name="publish_imu" value="$(arg publish_imu)" type="bool"/>
    <param name="radar_socket_buffer_bytes" value="$(arg radar_socket_buffer_bytes)" type="int"/>
    <param name="imu_socket_buffer_bytes" value="$(arg imu_socket_buffer_bytes)" type="int"/>
    <param name="max_buffered_frames" value="$(arg max_buffered_frames)" type="int"/>
    <param name="frame_timeout_sec" value="$(arg frame_timeout_sec)" type="double"/>
    <param name="socket_timeout_sec" value="$(arg socket_timeout_sec)" type="double"/>
    <param name="generated_python_dir" value="$(arg generated_python_dir)"/>
  </node>
</launch>
