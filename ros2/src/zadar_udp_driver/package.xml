<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zadar_udp_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 C++ driver for Zadar UDP-based sensors.</description>

  <maintainer email="support-team@zadarlabs.com">Zadar Labs</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>libcurl4-openssl-dev</build_depend>
  <build_export_depend>libcurl4-openssl-dev</build_export_depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>zadar_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
